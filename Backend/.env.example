# ==============================================================================
# AGRISENSE AI - BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# Port configuration
PORT=5001

# MongoDB Cloud / Local URI
# For production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster.mongodb.net/agrisense
MONGO_URI=mongodb://127.0.0.1:27017/agrisense

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# CORS Allowed Origins
# Staging/Production: Include frontend Netlify/Vercel domains, e.g. https://agrisense-app.netlify.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://agrisense-ai.vercel.app

# ------------------------------------------------------------------------------
# Google Cloud Platform & Earth Engine Configuration
# ------------------------------------------------------------------------------

# For local development / VM host (Path to JSON key file):
GOOGLE_APPLICATION_CREDENTIALS=./earth-engine-key.json

# For Cloud Run / Serverless Environments:
# Instead of keeping a file on disk, you can stringify the JSON key and set it here:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# GCP Project details (Optional for local, required for Vertex AI integration)
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1

# ------------------------------------------------------------------------------
# LLM & AI Advisor Configuration
# ------------------------------------------------------------------------------

# Gemini API Key (Required for chat and agronomy advice)
GEMINI_API_KEY=replace-with-gemini-key

# Set to true if deploying to Google Cloud and utilizing Enterprise Vertex AI APIs
USE_VERTEX_AI=false

# Model target version
GEMINI_MODEL=gemini-2.5-pro

# ==============================================================================
# CLOUD DEPLOYMENT BLUEPRINT REFERENCE:
# ==============================================================================
#
# 1. Frontend (Netlify / Vercel):
#    - Deploy Frontend/ directory.
#    - Set Environment Variable: VITE_API_BASE_URL=https://your-backend-cloudrun-url.a.run.app/api
#
# 2. Backend (Google Cloud Run / AWS Fargate):
#    - Deploy Backend/ directory via Dockerfile.
#    - Inject MONGO_URI, JWT_SECRET, GEMINI_API_KEY, and GOOGLE_SERVICE_ACCOUNT_JSON.
#
